# Browser-visible URL prefix. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api

# Development server only. /api/auth/... is proxied to /auth/... on FastAPI.
# This is not included in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8000

# Public privacy, support, and abuse-report contact. Rebuild after changing.
VITE_LEGAL_CONTACT_EMAIL=its.tebo0@gmail.com

# Cloudflare builds: override VITE_API_BASE_URL above with the actual HTTPS
# backend URL (hostname under donee.dev is still pending). API_PROXY_TARGET
# only serves local development/preview; it does not configure production routing.
