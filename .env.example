# Copy to .env and configure real credentials outside source control.
ENVIRONMENT="production"
DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/donee_database"
JWT_SECRET_KEY="replace-with-a-random-secret-of-at-least-32-bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_REGION="us-east-2"
AWS_S3_BUCKET_NAME="replace-me"
MAILGUN_API_KEY="replace-me"
MAILGUN_DOMAIN="mg.your-domain.example"
MAILGUN_FROM="donee@your-domain.example"
MAILGUN_REGION="us"
# Required when ENVIRONMENT=development; all mail goes to this inbox.
DEVELOPMENT_EMAIL="developer@your-domain.example"
